# 複製此檔為 .env 並填入實際值
# .env 不會 commit 進 git

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ticket_platform
DB_USER=root
DB_PASS=secret

APP_ENV=development
APP_TIMEZONE=Asia/Taipei
DB_TIMEZONE=+08:00

# 郵件配置（用於發送驗證郵件）
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your_username
MAIL_PASSWORD=your_password
MAIL_FROM=noreply@ticket-platform.local
MAIL_FROM_NAME=Ticket Platform

